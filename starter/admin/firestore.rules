rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEST MODE: anyone can read and write anything.
    // Lab and demo use only. Production rules require authentication
    // and per-collection checks; see the note in Task 5 of the lab.
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
